# Local development only. Copy to .env and supply a non-production database.
PENNY_DATABASE_URL=postgres://penny:penny@localhost:5432/penny?sslmode=disable
PENNY_HTTP_ADDRESS=:8080
PENNY_LOG_LEVEL=debug
PENNY_DATABASE_MAX_CONNECTIONS=10
PENNY_DATABASE_MIN_CONNECTIONS=1
PENNY_DATABASE_CONNECT_TIMEOUT=5s
PENNY_DATABASE_HEALTH_TIMEOUT=2s
PENNY_WORKER_HEALTH_INTERVAL=30s
PENNY_SHUTDOWN_TIMEOUT=15s

# Release metadata. CI sets build-time values; the deployed immutable digest is
# supplied at runtime because an OCI image cannot contain its own digest.
PENNY_ARTIFACT_DIGEST=local
PENNY_PRODUCT_MILESTONE=development

# Used only by the dedicated migration executable.
PENNY_MIGRATIONS_SOURCE=file://db/migrations

# Optional PostgreSQL integration-test database. Tests skip when unset.
PENNY_TEST_DATABASE_URL=

